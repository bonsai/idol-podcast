@prefix ip: <https://github.com/bonsai/idol-podcast/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ip:Topology a rdfs:Class ; rdfs:label "Topology" ; rdfs:comment "静的なノード、ポート、能力、接続可能性のグラフ"@ja .
ip:Workflow a rdfs:Class ; rdfs:label "Workflow" ; rdfs:comment "ステージ、遷移、トリガー、実行状態のグラフ"@ja .
ip:R2RContract a rdfs:Class ; rdfs:label "R2R contract" ; rdfs:comment "リポジトリ間でartifactを受け渡す契約"@ja .
ip:AWPlan a rdfs:Class ; rdfs:label "AW plan" ; rdfs:comment "意図を成果、受入条件、作業へ分解する設計"@ja .
ip:Repository a rdfs:Class .
ip:Node a rdfs:Class .
ip:Port a rdfs:Class .
ip:Capability a rdfs:Class .
ip:Artifact a rdfs:Class .
ip:WorkflowStep a rdfs:Class .
ip:Gate a rdfs:Class .
ip:Intent a rdfs:Class .
ip:Observation a rdfs:Class .
ip:Analysis a rdfs:Class .
ip:EditorialText a rdfs:Class .
ip:AudioEpisode a rdfs:Class .
ip:Provenance a rdfs:Class .
ip:Project a rdfs:Class ; rdfs:comment "入力型を出力型へ変換する責務単位"@ja .
ip:DataType a rdfs:Class ; rdfs:comment "プロジェクト間を流れるversioned data contract"@ja .
ip:TypeTransformation a rdfs:Class ; rdfs:comment "型変換として記録された具体的な仕事"@ja .
ip:Agent a rdfs:Class ; rdfs:comment "変換を実行する主体"@ja .
ip:Skill a rdfs:Class ; rdfs:comment "再利用可能な仕事の方法"@ja .
ip:Tool a rdfs:Class ; rdfs:comment "workflow taskから呼び出される実行能力"@ja .
ip:Plan a rdfs:Class ; rdfs:comment "成果とマイルストーンを持つ計画"@ja .
ip:Task a rdfs:Class ; rdfs:comment "skillとtoolに束縛された実行単位"@ja .

ip:contains a rdfs:Property ; rdfs:domain ip:Topology ; rdfs:range ip:Node .
ip:exposes a rdfs:Property ; rdfs:domain ip:Repository ; rdfs:range ip:Port .
ip:supports a rdfs:Property ; rdfs:domain ip:Port ; rdfs:range ip:Capability .
ip:executes a rdfs:Property ; rdfs:domain ip:Workflow ; rdfs:range ip:WorkflowStep .
ip:consumes a rdfs:Property ; rdfs:domain ip:WorkflowStep ; rdfs:range ip:Artifact .
ip:produces a rdfs:Property ; rdfs:domain ip:WorkflowStep ; rdfs:range ip:Artifact .
ip:guardedBy a rdfs:Property ; rdfs:domain ip:WorkflowStep ; rdfs:range ip:Gate .
ip:producer a rdfs:Property ; rdfs:domain ip:R2RContract ; rdfs:range ip:Repository .
ip:consumer a rdfs:Property ; rdfs:domain ip:R2RContract ; rdfs:range ip:Repository .
ip:exchanges a rdfs:Property ; rdfs:domain ip:R2RContract ; rdfs:range ip:Artifact .
ip:hasProvenance a rdfs:Property ; rdfs:domain ip:Artifact ; rdfs:range ip:Provenance .
ip:realizes a rdfs:Property ; rdfs:domain ip:AWPlan ; rdfs:range ip:Intent .
ip:decomposesInto a rdfs:Property ; rdfs:domain ip:AWPlan ; rdfs:range ip:Workflow .
ip:uses a rdfs:Property ; rdfs:domain ip:Analysis ; rdfs:range ip:Observation .
ip:cites a rdfs:Property ; rdfs:domain ip:EditorialText ; rdfs:range ip:Observation .
ip:derivedFrom a rdfs:Property ; rdfs:domain ip:AudioEpisode ; rdfs:range ip:EditorialText .
ip:owns a rdfs:Property ; rdfs:domain ip:Project ; rdfs:range ip:TypeTransformation .
ip:accepts a rdfs:Property ; rdfs:domain ip:Project ; rdfs:range ip:DataType .
ip:emits a rdfs:Property ; rdfs:domain ip:Project ; rdfs:range ip:DataType .
ip:transforms a rdfs:Property ; rdfs:domain ip:TypeTransformation ; rdfs:range ip:DataType .
ip:validatedBy a rdfs:Property ; rdfs:domain ip:TypeTransformation ; rdfs:range ip:Gate .
ip:performs a rdfs:Property ; rdfs:domain ip:Agent ; rdfs:range ip:TypeTransformation .
ip:usesSkill a rdfs:Property ; rdfs:domain ip:Agent ; rdfs:range ip:Skill .
ip:invokes a rdfs:Property ; rdfs:domain ip:Task ; rdfs:range ip:Tool .
ip:requiresSkill a rdfs:Property ; rdfs:domain ip:Task ; rdfs:range ip:Skill .
ip:conformsTo a rdfs:Property ; rdfs:domain ip:Agent ; rdfs:range ip:Agent .
ip:plannedBy a rdfs:Property ; rdfs:domain ip:Project ; rdfs:range ip:Agent .

ip:IdolDb a ip:Repository, ip:Node ; rdfs:label "bonsai/idol-db" .
ip:IdolResearch a ip:Repository, ip:Node ; rdfs:label "bonsai/idol-research" .
ip:IdolPodcast a ip:Repository, ip:Node ; rdfs:label "bonsai/idol-podcast" .
ip:PodcastGenerator a ip:Node ; rdfs:label "podcast-generator" .
ip:HumanEditor a ip:Node ; rdfs:label "human editor" .
ip:IdolEcosystemTopology a ip:Topology ; ip:contains ip:IdolDb, ip:IdolResearch, ip:IdolPodcast, ip:PodcastGenerator, ip:HumanEditor .
ip:IdolCritiqueWorkflow a ip:Workflow ; rdfs:label "idol-critique-podcast" .
ip:IdolCritiqueR2R a ip:R2RContract ; ip:producer ip:IdolDb, ip:IdolResearch ; ip:consumer ip:IdolPodcast, ip:PodcastGenerator .
ip:IdolPodcastAW a ip:AWPlan ; ip:realizes ip:IdolCritiqueIntent ; ip:decomposesInto ip:IdolCritiqueWorkflow .
ip:IdolCritiqueIntent a ip:Intent ; rdfs:label "既存のidolデータと研究を、検証可能な公共の批評へ変換する"@ja .
ip:IdolDbProject a ip:Project ; rdfs:label "idol-db project" ; ip:emits ip:CanonicalRecordSet .
ip:IdolResearchProject a ip:Project ; rdfs:label "idol-research project" ; ip:accepts ip:CanonicalRecordSet ; ip:emits ip:AnalysisPacket .
ip:IdolPodcastProject a ip:Project ; rdfs:label "idol-podcast project" ; ip:accepts ip:AnalysisPacket ; ip:emits ip:ApprovedScript .
ip:PodcastGeneratorProject a ip:Project ; rdfs:label "podcast-generator project" ; ip:accepts ip:ApprovedScript ; ip:emits ip:AudioEpisode .
ip:CanonicalRecordSet a ip:DataType ; rdfs:label "canonical.idol-record-set.v1" .
ip:AnalysisPacket a ip:DataType ; rdfs:label "research.analysis-packet.v1" .
ip:ApprovedScript a ip:DataType ; rdfs:label "editorial.approved-script.v1" .
ip:AudioEpisodeType a ip:DataType ; rdfs:label "audio.podcast-episode.v1" .
ip:MarketingResearchPacket a ip:DataType ; rdfs:label "marketing.research-packet.v1" .
ip:ProducerProjectConcept a ip:DataType ; rdfs:label "producer.project-concept.v1" .
ip:ProducerExecutionPlan a ip:DataType ; rdfs:label "producer.execution-plan.v1" .
ip:WorkflowTaskSet a ip:DataType ; rdfs:label "workflow.task-set.v1" .
ip:MarketingAgent a ip:Agent ; rdfs:label "idol-marketing-agent" ; ip:performs ip:MarketingResearch .
ip:ProducerAgent a ip:Agent ; rdfs:label "idol-producer-agent" ; ip:performs ip:PlanProject .
ip:MarketingResearch a ip:TypeTransformation ; ip:transforms ip:MarketingResearchPacket .
ip:PlanProject a ip:TypeTransformation ; ip:transforms ip:ProducerExecutionPlan .
ip:DecomposePlan a ip:TypeTransformation ; ip:transforms ip:WorkflowTaskSet .
ip:ProducerAgentArchitype a ip:Agent ; rdfs:label "bonsai/producer-agent architype" .
ip:IdolPAgent a ip:Agent ; rdfs:label "bonsai/idol-p-agent practical type" ; ip:conformsTo ip:ProducerAgentArchitype .
ip:IdolPodcastProject ip:plannedBy ip:IdolPAgent .
ip:Canonicalize a ip:TypeTransformation ; ip:transforms ip:CanonicalRecordSet .
ip:Analyze a ip:TypeTransformation ; ip:transforms ip:AnalysisPacket .
ip:WriteCritique a ip:TypeTransformation ; ip:transforms ip:ApprovedScript .
ip:GenerateAudio a ip:TypeTransformation ; ip:transforms ip:AudioEpisodeType .
